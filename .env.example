# OpenAI
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-5.4-mini          # check platform.openai.com/docs/models for the current small model

# Agent limits
MAX_AGENT_STEPS=5
MAX_OUTPUT_TOKENS=500
MAX_INPUT_CHARS=500
CONTEXT_MESSAGE_LIMIT=20
DAILY_MESSAGE_LIMIT=50
DEMO_DAILY_MESSAGE_LIMIT=20
DEFAULT_TIMEZONE=America/Los_Angeles

# Database (Phase 2+)
DATABASE_URL=postgresql+psycopg://expense:expense@localhost:5432/expense_agent

# Auth (Phase 3+)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# CORS (Phase 3+)
CORS_ORIGINS=http://localhost:5173
